<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Git in Runesmith: changes, commits, branches, history, diffs, change markers, cloning, and pull requests on the hosting services' plugins.</Description>
    <!-- Flags text users see that is written in the code instead of locales/en. -->
    <RunesmithLocalize>true</RunesmithLocalize>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Runesmith.Git.Contracts\Runesmith.Git.Contracts.csproj" />
  </ItemGroup>
  <!-- Runesmith supplies these when it loads the plugin, so none of them is copied next to it. -->
  <ItemGroup>
    <PackageReference Include="Runesmith.Sdk" ExcludeAssets="runtime" />
    <PackageReference Include="Runesmith.Text" ExcludeAssets="runtime" />
    <PackageReference Include="HammerUI" ExcludeAssets="runtime" />
    <PackageReference Include="Avalonia" ExcludeAssets="runtime" />
  </ItemGroup>
  <!-- The TextMate grammars of Git's own files ship beside the assembly, where GrammarFiles finds them. -->
  <ItemGroup>
    <None Include="grammars\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Runesmith.Git.Tests" />
  </ItemGroup>
</Project>
